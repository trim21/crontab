FROM golang:1.27-trixie@sha256:2336eda24930976591abea806d9b7d99eeae38238f19755c5deec02facdc1594 AS s3cache

WORKDIR /src

RUN git clone https://github.com/trim21/s3-as-cache .

RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /s3cache ./cmd/s3cache


FROM debian:trixie-slim@sha256:a72b4433de1cf7d6bae0c4cee74d0547f58601a643b3375f070c51600d63b6b2

RUN apt-get update &&\
    apt-get install -y --no-install-recommends ca-certificates curl git &&\
    curl -LsSf https://astral.sh/uv/install.sh | env UV_INSTALL_DIR=/usr/local/bin sh &&\
    uv --version &&\
    curl --proto '=https' --tlsv1.2 -LsSf https://github.com/j178/prek/releases/download/v0.5.9/prek-installer.sh | env PREK_INSTALL_DIR=/usr/local/bin PREK_NO_MODIFY_PATH=1 sh &&\
    prek --version &&\
    rm -rf /var/lib/apt/lists/*

COPY --from=s3cache /s3cache /usr/local/bin/s3cache
